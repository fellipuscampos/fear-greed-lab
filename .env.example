# SQLite for local dev; swap for a Postgres connection string in production
# (see prisma/schema.prisma — change provider to "postgresql" when deploying).
DATABASE_URL="file:./dev.db"

# Optional: how many days of history the `npm run backfill` script pulls.
BACKFILL_DAYS=365

# Optional: if set, /api/ingest requires `Authorization: Bearer <CRON_SECRET>`.
# Set this before exposing the ingest endpoint in production.
CRON_SECRET=
