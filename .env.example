# Postgres connection string. In production this comes from the Neon
# integration (Vercel Marketplace) and is injected automatically.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Unpooled connection, used only for running migrations (DDL over pgbouncer
# is unreliable). Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Optional: how many days of history the `npm run backfill` script pulls.
BACKFILL_DAYS=365

# Required in production: /api/ingest requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends this header automatically when CRON_SECRET is set as an env var.
CRON_SECRET=
